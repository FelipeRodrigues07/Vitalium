# ================================
# PostgreSQL Configuration
# ================================
POSTGRES_USER=vitalium
POSTGRES_PASSWORD=vitalium123
POSTGRES_DB=vitalium
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ================================
# JWT Configuration
# ================================
JWT_SECRET=your-super-secret-jwt-key-for-vitalium-backend

# ================================
# Next.js Frontend Configuration
# ================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ================================
# Environment
# ================================
NODE_ENV=production

# ================================
# RabbitMQ Configuration
# ================================
RABBITMQ_USER=vitalium
RABBITMQ_PASS=vitalium123

# ================================
# WhatsApp Cloud API Configuration
# ================================
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=vitalium_webhook_verify
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_API_VERSION=v20.0

# ================================
# AI Service Configuration
# ================================
# AI Provider: openai or anthropic
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Service Logging
AI_LOG_LEVEL=INFO

# AI System Prompt (optional, has default)
# AI_SYSTEM_PROMPT=Você é um assistente médico virtual...
