# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_TO_AI=chat.to_ai
RABBITMQ_QUEUE_FROM_AI=chat.from_ai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Alternative: Claude (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Provider (openai | anthropic)
AI_PROVIDER=openai

# System Prompt
SYSTEM_PROMPT=Você é um assistente médico virtual chamado VitaliumAI. Sua função é ajudar pacientes com informações gerais sobre saúde, agendar consultas e responder dúvidas não emergenciais. Seja empático, claro e objetivo. NUNCA faça diagnósticos médicos. Em casos graves, oriente buscar atendimento presencial imediato.

# Logging
LOG_LEVEL=INFO
